# Copy to .env for local dev. On Vercel, set the same names in Project Settings > Environment Variables.

# Firebase web app config (Firebase console > Project settings > General > Your apps > Web app).
# These are safe in the browser: the security rules in firestore.rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, local only: "true" talks to the Firebase emulators (npm run emulators) instead of the real project.
VITE_FIREBASE_EMULATOR=

# Groq key from console.groq.com/keys: server only (api/groq.js). Never give it a VITE_ prefix.
GROQ_API_KEY=

# ── Launch settings (server, set on Vercel) ──
# AI limits per student. Counted in Upstash Redis (Vercel > Storage > Upstash, free tier).
# Without Upstash the limit is only per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_DAILY_LIMIT=120
AI_MINUTE_LIMIT=15
# Email must be verified before AI features work (default true; false with local emulators).
AI_REQUIRE_VERIFIED_EMAIL=

# ── Shown on the Privacy policy and Terms pages ──
VITE_LEGAL_NAME=
VITE_CONTACT_EMAIL=
VITE_GRIEVANCE_OFFICER=
