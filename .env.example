# Copy to .env for local dev. On Vercel, set the same names in Project Settings > Environment Variables.
# Supabase project URL and anon (publishable) key: safe in the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Groq key from console.groq.com/keys: server only (api/groq.js). Never give it a VITE_ prefix.
GROQ_API_KEY=
